{
  "name": "formulario-contacto-lasalle",
  "version": "1.0.0",
  "description": "Formulario de contacto La Salle ejecutable en ambientes de desarrollo, pruebas y producción",
  "main": "src/server.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --env-file=config/development.env --env-file-if-exists=.env --watch src/server.js",
    "start:test": "node --env-file=config/test.env --env-file-if-exists=.env src/server.js",
    "start": "node --env-file=config/production.env src/server.js",
    "seed": "node --env-file=config/development.env scripts/seed-dev.js",
    "test": "node --env-file=config/test.env --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --env-file=config/test.env --test --test-concurrency=1 \"tests/unitarias/*.test.js\"",
    "test:integracion": "node --env-file=config/test.env --test --test-concurrency=1 \"tests/integracion/*.test.js\"",
    "test:e2e": "node --env-file=config/test.env --test --test-concurrency=1 \"tests/funcionales/*.e2e.js\"",
    "test:actividad8": "node --env-file=config/test.env --test --test-concurrency=1 --test-reporter=spec \"tests/unitarias/*.test.js\" \"tests/integracion/*.test.js\" \"tests/funcionales/*.e2e.js\""
  },
  "author": "Juan Felipe Jiménez Morales",
  "license": "UNLICENSED",
  "dependencies": {
    "express": "5.1.0"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
