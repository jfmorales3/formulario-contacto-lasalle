# Copie este archivo como .env para sobrescribir valores locales.
# El archivo .env real NUNCA se sube al repositorio ni se incluye en el .zip.

# Token para consultar GET /admin/mensajes (encabezado: Authorization: Bearer <token>).
# Si se deja vacío, la ruta de administración queda deshabilitada.
ADMIN_TOKEN=cambie-este-valor-por-uno-largo-y-aleatorio

# Opcionales: sobrescriben lo definido en config/<ambiente>.env
# PORT=3000
# LOG_LEVEL=debug
